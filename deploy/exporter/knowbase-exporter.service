[Unit]
Description=knowbase Lark exporter daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=10
EnvironmentFile=/etc/knowbase/exporter.env
# systemd does not reliably read $HOME from the User= account's passwd entry;
# ssh and git both resolve their config (~/.ssh, ~/.gitconfig, credential store)
# from $HOME, and those files live under /var/lib/knowbase (see README.md), so
# it must be set explicitly here to match.
Environment=HOME=/var/lib/knowbase
ExecStart=/usr/bin/env knowbase exporter --repo /var/lib/knowbase/repo --space ${KNOWBASE_LARK_SPACE}
# It is recommended to run knowbase exporter under a dedicated non-root user.
# Create user and group with: sudo useradd -r -d /var/lib/knowbase -m -s /bin/false knowbase
User=knowbase
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
