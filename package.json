{
  "name": "knowbase",
  "version": "1.1.1",
  "description": "以飞书知识库为唯一真相源的团队知识镜像：exporter 把飞书导出为 Git 仓库，成员本机维护一份只读 Markdown 镜像，agent 读走本地 grep、写走飞书。安装即忘，后台自动同步。",
  "keywords": [
    "knowledge-base",
    "git",
    "sync",
    "ai",
    "claude-code",
    "markdown",
    "daemon",
    "feishu",
    "lark",
    "mirror"
  ],
  "license": "MIT",
  "author": "zhangze",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangze-github/knowbase.git"
  },
  "type": "module",
  "bin": {
    "knowbase": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsc -w -p tsconfig.json",
    "prebuild": "rm -rf dist"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "update-notifier": "^7.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/update-notifier": "^6.0.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
